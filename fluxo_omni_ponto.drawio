        <mxCell id="edge7" edge="1" parent="1" source="c2_dispatch" target="c3_controlid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=2.5;">
