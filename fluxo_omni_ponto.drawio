<mxfile host="app.diagrams.net" modified="2026-10-18T02:30:00.000Z" agent="Antigravity" version="22.1.0">
  <diagram id="omni-ponto-exec" name="Omni Ponto - Arquitetura Executiva">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" background="#ffffff" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="banner" value="OMNI PONTO: ARQUITETURA DE APONTAMENTO WHATSAPP &amp; APROPRIAÇÃO SIENGE ERP&#xa;Automação de Canteiro sem Relógio Físico • Rateio Multi-Obra • Portaria MTE 671" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0284c7;strokeWidth=2;fontColor=#ffffff;fontFamily=Outfit;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1480" height="60" as="geometry" />
        </mxCell>

        <!-- COLUNA 1: CANTEIRO & WHATSAPP -->
        <mxCell id="col1" value="1. CANTEIRO DE OBRAS &amp; INTERFACE WHATSAPP" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontFamily=Inter;fontSize=14;fontStyle=1;startSize=40;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="460" height="900" as="geometry" />
        </mxCell>

        <!-- Card: Disparo Proativo -->
        <mxCell id="c1_disparo" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;⏰ DISPARO PROATIVO (07:50 AM)&lt;/b&gt;&lt;br&gt;O robô da Omni chama o operário no WhatsApp com a sugestão da sua obra padrão de hoje." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col1">
          <mxGeometry x="25" y="55" width="410" height="70" as="geometry" />
        </mxCell>

        <!-- Card Imagem Embutida: WhatsApp Preview -->
        <mxCell id="c1_img_box" value="TELA REAL DO WHATSAPP (Mensagem Recebida pelo Operário)" link="whatsapp_preview.png" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#15803d;fontFamily=Inter;fontSize=11;fontStyle=1;startSize=25;rounded=1;" vertex="1" parent="col1">
          <mxGeometry x="25" y="140" width="410" height="280" as="geometry" />
        </mxCell>
        <mxCell id="c1_wa_img" value="" link="whatsapp_preview.png" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png;base64," vertex="1" parent="c1_img_box">
          <mxGeometry x="20" y="32" width="370" height="209" as="geometry" />
        </mxCell>
        <mxCell id="c1_img_btn" value="&lt;b&gt;🔍 CLIQUE AQUI PARA ABRIR O PRINT ORIGINAL&lt;/b&gt;" link="whatsapp_preview.png" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16a34a;strokeColor=#15803d;fontColor=#ffffff;fontFamily=Inter;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="c1_img_box">
          <mxGeometry x="20" y="247" width="370" height="24" as="geometry" />
        </mxCell>

        <!-- Card: Decisão de Obra -->
        <mxCell id="c1_decisao" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;📍 CONFIRMAÇÃO OU MUDANÇA DE OBRA&lt;/b&gt;&lt;br&gt;• Opção 1: [Confirmar Obra Solar (CC 101)]&lt;br&gt;• Opção 2: [Mudar para Obra Bosque (CC 102)]&lt;br&gt;• Envia Localização GPS do WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col1">
          <mxGeometry x="25" y="435" width="410" height="85" as="geometry" />
        </mxCell>

        <!-- Card: Transição 13:00 (Multi-Obra) -->
        <mxCell id="c1_turno2" value="&lt;b style=&quot;font-size: 12px; color: #b45309;&quot;&gt;🔄 TRANSIÇÃO 13:00 (SEGUNDA OBRA NO MESMO DIA)&lt;/b&gt;&lt;br&gt;Operário trabalhou 4h na Obra Solar e agora bate retorno na Obra Bosque.&lt;br&gt;O bot registra o novo centro de custo sem quebrar a jornada CLT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#78350f;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col1">
          <mxGeometry x="25" y="535" width="410" height="85" as="geometry" />
        </mxCell>

        <!-- Card: Plano B (Sem Sinal / Bateria) -->
        <mxCell id="c1_planob" value="&lt;b style=&quot;font-size: 12px; color: #b91c1c;&quot;&gt;⚠️ PLANO B: SEM SINAL OU SEM BATERIA NO CANTEIRO&lt;/b&gt;&lt;br&gt;1. Operário solicita entrada retroativa informando horário e motivo.&lt;br&gt;2. O Mestre de Obras recebe alerta no WhatsApp e clica em [APROVAR].&lt;br&gt;3. Ponto validado com assinatura digital do supervisor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col1">
          <mxGeometry x="25" y="635" width="410" height="95" as="geometry" />
        </mxCell>

        <!-- COLUNA 2: ENGINE OMNI PONTO -->
        <mxCell id="col2" value="2. ENGINE OMNI PONTO (MOTOR DE REGRAS &amp; AUDITORIA)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;fontFamily=Inter;fontSize=14;fontStyle=1;startSize=40;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="100" width="480" height="900" as="geometry" />
        </mxCell>

        <!-- Card: Geofencing e GPS -->
        <mxCell id="c2_geo" value="&lt;b style=&quot;font-size: 13px; color: #0284c7;&quot;&gt;📡 VALIDAÇÃO DE GEOFENCING (GPS)&lt;/b&gt;&lt;br&gt;Verifica se o ponto GPS está a menos de 100m do perímetro do canteiro.&lt;br&gt;Bloqueia tentativa de bater ponto fora do local de trabalho." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col2">
          <mxGeometry x="25" y="60" width="430" height="75" as="geometry" />
        </mxCell>

        <!-- Card: Comprovante Legal MTE -->
        <mxCell id="c2_comprovante" value="&lt;b style=&quot;font-size: 13px; color: #15803d;&quot;&gt;📜 PROTOCOLO LEGAL (PORTARIA MTE 671 / REP-A)&lt;/b&gt;&lt;br&gt;Emite imediatamente comprovante no WhatsApp do trabalhador com:&lt;br&gt;• Data/Hora oficial • Hash de Inalterabilidade • Protocolo Único." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;fontColor=#065f46;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col2">
          <mxGeometry x="25" y="155" width="430" height="75" as="geometry" />
        </mxCell>

        <!-- SHAPE DOCUMENT: NOTA TÉCNICA / REGRAS DE NEGÓCIO -->
        <mxCell id="c2_doc" value="&lt;b style=&quot;font-size: 13px; color: #4338ca;&quot;&gt;📄 ESPECIFICAÇÃO DE NEGÓCIO &amp; RATEIO (DOCUMENTO)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Regra de Rateio Multi-Obra:&lt;/b&gt;&lt;br&gt;Quando o operário divide o dia entre duas obras, o motor calcula o custo proporcional das horas trabalhadas por centro de custo para alimentar o Sienge CMO.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Compatibilização com Control iD:&lt;/b&gt;&lt;br&gt;Como o Control iD não suporta 2 obras no mesmo dia, o motor unifica as batidas (08:00, 12:00, 13:00, 17:00) em uma jornada contratual CLT contínua de 8h.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Segurança Jurídica:&lt;/b&gt;&lt;br&gt;Todas as marcações são assinadas digitalmente e gravadas em banco de dados inalterável (Supabase PostgreSQL) para auditorias trabalhistas." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;fontColor=#312e81;fontFamily=Inter;fontSize=11;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;" vertex="1" parent="col2">
          <mxGeometry x="25" y="250" width="430" height="230" as="geometry" />
        </mxCell>

        <!-- Card: Divisor de Cargas (Dispatcher) -->
        <mxCell id="c2_dispatch" value="&lt;b style=&quot;font-size: 13px; color: #0f172a;&quot;&gt;⚡ MOTOR DE DISPATCH DUAL EM TEMPO REAL&lt;/b&gt;&lt;br&gt;Consolida as marcações e dispara simultaneamente para os dois destinos:&lt;br&gt;• Rota 1 ➔ Control iD / RHiD API (Ponto CLT)&lt;br&gt;• Rota 2 ➔ Sienge ERP API (Apropriação de Custo CMO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Inter;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col2">
          <mxGeometry x="25" y="505" width="430" height="85" as="geometry" />
        </mxCell>

        <!-- COLUNA 3: DESTINOS SIENGE & CONTROL ID -->
        <mxCell id="col3" value="3. DESTINOS &amp; IMPACTO NA GESTÃO OMNI" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontFamily=Inter;fontSize=14;fontStyle=1;startSize=40;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="480" height="900" as="geometry" />
        </mxCell>

        <!-- Destino 1: Control iD -->
        <mxCell id="c3_controlid" value="&lt;b style=&quot;font-size: 13px; color: #6b21a8;&quot;&gt;🟣 CONTROL iD / RHiD (FOLHA &amp; PONTO CLT)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Recebe jornada contínua homologada de 8h diárias.&lt;br&gt;• Espelho de ponto oficial MTE 671 sem duplicidades.&lt;br&gt;• Integrado perfeitamente com a folha de pagamento corporativa.&lt;br&gt;• Status: &lt;b style=&quot;color: #16a34a;&quot;&gt;CONFORME CLT / PORTARIA 671&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#581c87;fontFamily=Inter;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="col3">
          <mxGeometry x="25" y="60" width="430" height="120" as="geometry" />
        </mxCell>

        <!-- Destino 2: Sienge ERP -->
        <mxCell id="c3_sienge" value="&lt;b style=&quot;font-size: 13px; color: #b45309;&quot;&gt;🟠 SIENGE ERP (APROPRIAÇÃO DE MÃO DE OBRA)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Obra Solar (CC 101):&lt;/b&gt; 4.0h alocadas = R$ 130,00 apropriado no orçamento.&lt;br&gt;• &lt;b&gt;Obra Bosque (CC 102):&lt;/b&gt; 4.0h alocadas = R$ 130,00 apropriado no orçamento.&lt;br&gt;• Alimentação automática da API &lt;code&gt;/cmo/production-records&lt;/code&gt;.&lt;br&gt;• Status: &lt;b style=&quot;color: #16a34a;&quot;&gt;CUSTO DA OBRA EM TEMPO REAL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;strokeWidth=2;fontColor=#78350f;fontFamily=Inter;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="col3">
          <mxGeometry x="25" y="210" width="430" height="140" as="geometry" />
        </mxCell>

        <!-- Resultados e Benefícios -->
        <mxCell id="c3_beneficios" value="&lt;b style=&quot;font-size: 13px; color: #0f172a;&quot;&gt;🚀 BENEFÍCIOS DIRETOS PARA A DIRETORIA OMNI&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Fim da defasagem de 30 dias:&lt;/b&gt; O custo de mão de obra entra no Sienge no mesmo dia trabalhado.&lt;br&gt;• &lt;b&gt;Zero filas no canteiro:&lt;/b&gt; 100 colaboradores batem ponto pelo WhatsApp em segundos.&lt;br&gt;• &lt;b&gt;Economia com hardware:&lt;/b&gt; Elimina compras de relógios físicos de R$ 4.000 para obras rápidas.&lt;br&gt;• &lt;b&gt;Anti-Fraude Garantido:&lt;/b&gt; Geolocalização e aprovação de superiores para qualquer exceção." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontFamily=Inter;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="col3">
          <mxGeometry x="25" y="380" width="430" height="160" as="geometry" />
        </mxCell>

